{
  "gemini-normaliser": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"{GUARD}\" --agy PreToolUse || echo '{\"decision\":\"ask\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"{GUARD}\" --agy PostToolUse || echo '{}'"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/usr/bin/python3 \"{GUARD}\" --agy PreInvocation || echo '{}'"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/python3 \"{GUARD}\" --agy Stop || echo '{}'"
      }
    ]
  }
}
